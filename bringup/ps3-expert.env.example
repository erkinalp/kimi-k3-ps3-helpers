# Copy to /etc/ps3-expert.env on each console and edit.
#
# No secrets belong in this file. The P3XC worker does not authenticate; keep
# the compute VLAN private and off any untrusted network (see rack/ networking
# notes). Do not add credentials here.

# Deployable C worker on real hardware:
EXPERT_BIN=/opt/ps3-cluster/build/expert_node_host

# ...or the portable reference worker (no SPE/RSX toolchain needed):
# EXPERT_BIN=python3
# RAM_COFFERS=/opt/ram-coffers/ps3-cluster

# Directory holding this console's packed expert file(s), named
# L<layer>-E<expert>.exp (produced by ram-coffers/tools/pack_expert.py).
EXPERT_DIR=/opt/ps3-cluster/experts

# TCP port the worker listens on.
EXPERT_PORT=9000
